# Optional. Everything can be set in the web UI instead (UI values win).
# Use with `env_file: ./watchlist-sync/.env` in docker-compose if you prefer env vars.

# Password-protect the web UI (username can be anything)
UI_PASSWORD=
PORT=8789

# Pre-fill settings
SONARR_URL=
SONARR_API_KEY=
RADARR_URL=
RADARR_API_KEY=
BAZARR_URL=
BAZARR_API_KEY=
SYNC_INTERVAL_MINUTES=15
DRY_RUN=true
LOG_LEVEL=INFO
