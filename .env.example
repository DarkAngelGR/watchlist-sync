# Optional. Everything can be set in the web UI instead (UI values win).
# Use with `env_file: ./watchlist-sync/.env` in docker-compose if you prefer env vars.

# Password-protect the web UI (username can be anything)
UI_PASSWORD=
PORT=8789

# Pre-fill settings
SONARR_URL=
SONARR_API_KEY=
RADARR_URL=
RADARR_API_KEY=
BAZARR_URL=
BAZARR_API_KEY=
SYNC_INTERVAL_MINUTES=15
DRY_RUN=true
AUTO_FETCH=false
AUTO_FETCH_FREE_GIB=50
LOG_LEVEL=INFO

# Optional Orama AI ranking. Set UI_PASSWORD and supply the full chat completions URL.
RECOMMEND_URL=
RECOMMEND_MODEL=
RECOMMEND_API_KEY=

# Optional notifications. NTFY_URL is a topic URL (https://ntfy.sh/mytopic or your server).
# NTFY_TOKEN and DISCORD_WEBHOOK are secrets. Event flags default to on.
NTFY_URL=
NTFY_TOKEN=
DISCORD_WEBHOOK=
NOTIFY_ADDED=true
NOTIFY_DOWNLOADED=true
NOTIFY_FAILED=true

# /health/full reports the last successful sync as stale after this many intervals (default 3).
HEALTH_STALE_FACTOR=3
