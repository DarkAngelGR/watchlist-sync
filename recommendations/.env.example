# Copy to .env, fill in and never commit .env
# The Minisforum's fixed LAN IPv4 address; choose 127.0.0.1 to test locally only
AI_BIND_IP=127.0.0.1
# Generate a 32-byte secret: openssl rand -hex 32
API_KEY=
MEDIA_SOURCE=plex

# Plex: use exactly one Plex account ID, not the full server's combined history
PLEX_URL=http://192.168.1.100:32400
PLEX_TOKEN=
PLEX_ACCOUNT_ID=

# Instead, for Jellyfin set MEDIA_SOURCE=jellyfin and the following:
JELLYFIN_URL=http://192.168.1.100:8096
JELLYFIN_API_KEY=
JELLYFIN_USER_ID=

EMBED_MODEL=qwen3-embedding:0.6b
HISTORY_LIMIT=1500
REFRESH_MINUTES=15
